generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum FileFormat {
  STL
  OBJ
}

enum FileStatus {
  ANALYZING
  READY
  ERROR
}

enum OrderStatus {
  DRAFT
  AWAITING_PAYMENT
  PAID
  QUEUED
  PRINTING
  READY
  SHIPPED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  name         String?
  createdAt    DateTime @default(now())

  orders Order[]
}

model Material {
  id            String  @id @default(cuid())
  slug          String  @unique
  name          String
  description   String?
  // Legacy (price per cm³) — no longer used for quotes; kept so `prisma db push` never drops data.
  pricePerCm3   Decimal @default(0) @db.Decimal(10, 4)

  // Time-based pricing. NULL = use the recommended value for this material (lib/pricing/defaults.ts).
  hourlyRateCents      Int?     // printer time, kopecks per hour
  printSpeedCm3PerHour Decimal? @db.Decimal(8, 2) // model volume printed per hour
  spoolPriceCents      Int?     // price of one spool, kopecks
  spoolWeightG         Int?     // grams of plastic on the spool
  densityGcm3          Decimal? @db.Decimal(6, 3)
  infillPercent        Int?     // share of the solid model volume actually printed
  setupFeeCents Int     @default(0)
  minPriceCents Int     @default(500)
  leadTimeDays  Int     @default(2)
  active        Boolean @default(true)

  // Relative 0-100 ratings for comparing materials against each other in this
  // lineup — not lab-measured absolute values.
  strength      Int     @default(50)
  flexibility   Int     @default(50)
  heatResistance Int    @default(50)
  bestFor       String?

  // Storage key of the illustration shown when picking this material.
  imageKey      String?

  colors     Color[]
  finishes   Finish[]
  orderItems OrderItem[]
}

model Color {
  id         String @id @default(cuid())
  materialId String
  name       String
  // Russian display name; the RU site falls back to a built-in translation of `name`, then `name` itself.
  nameRu     String?
  hex        String
  // "" for the plain material; a composite from the Bambuddy spool inventory keeps its full
  // name here (e.g. "ABS-CF15" under ABS) and is shown to customers as its own group.
  variant    String  @default("")
  // "manual" (added in the admin) or "bambuddy" (synced from the Bambuddy spool inventory).
  source     String  @default("manual")
  // Bambuddy's identity of the synced color ("<variant>|<name>") — survives admin renames.
  externalKey String?
  // Bambuddy: grams left on all matching spools at the last sync. Customers only see synced
  // colors with at least the "min stock" setting (lib/settings.ts).
  stockGrams Int?
  // Price of one spool of this color, kopecks; NULL = the material's spool price.
  spoolPriceCents Int?

  material   Material    @relation(fields: [materialId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([materialId, variant, name])
  @@unique([materialId, externalKey])
}

// Small key/value store for admin-editable site settings.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Finish {
  id         String  @id @default(cuid())
  materialId String
  name       String
  nameRu     String?
  multiplier Decimal @default(1) @db.Decimal(5, 3)

  material   Material    @relation(fields: [materialId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([materialId, name])
}

model UploadedFile {
  id             String     @id @default(cuid())
  storageKey     String
  originalName   String
  format         FileFormat
  sizeBytes      Int
  status         FileStatus @default(ANALYZING)
  errorMessage   String?
  volumeCm3      Decimal?   @db.Decimal(12, 4)
  bboxXMm        Decimal?   @db.Decimal(10, 3)
  bboxYMm        Decimal?   @db.Decimal(10, 3)
  bboxZMm        Decimal?   @db.Decimal(10, 3)
  triangleCount  Int?
  createdAt      DateTime   @default(now())

  orderItems OrderItem[]
}

model ShowcaseItem {
  id         String   @id @default(cuid())
  title      String
  storageKey String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
}

model Order {
  id              String      @id @default(cuid())
  userId          String?
  status          OrderStatus @default(DRAFT)
  shippingName    String?
  shippingAddress String?
  shippingCity    String?
  shippingPostal  String?
  shippingCountry String?
  email           String?
  totalCents      Int         @default(0)
  stripeSessionId String?     @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user  User?       @relation(fields: [userId], references: [id])
  items OrderItem[]
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  fileId         String
  materialId     String
  colorId        String?
  finishId       String?
  quantity       Int     @default(1)
  // Customer's choices: model size in % of the uploaded file, and slicer infill in %
  // (NULL on orders placed before infill could be picked).
  scalePercent   Int     @default(100)
  infillPercent  Int?
  unitPriceCents Int
  totalPriceCents Int

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  file     UploadedFile @relation(fields: [fileId], references: [id])
  material Material @relation(fields: [materialId], references: [id])
  color    Color?   @relation(fields: [colorId], references: [id])
  finish   Finish?  @relation(fields: [finishId], references: [id])
}
